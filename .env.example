NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@db:5432/ecommerce_db?schema=public
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
JWT_EXPIRATION=1d
PORT=3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60000
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE=2097152
STUB_DEFAULT_STOCK=50
RUN_SEED=true
PGADMIN_EMAIL=admin@store.com
PGADMIN_PASSWORD=change-this-development-password
