NODE_ENV=development
USERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ecommerce_db?schema=users
PRODUCTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ecommerce_db?schema=products
ORDERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ecommerce_db?schema=orders
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ecommerce_db?schema=notifications
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
PERF_REPLICATION_PASSWORD=
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
JWT_EXPIRATION=1d
PORT=3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60000
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE=2097152
STUB_DEFAULT_STOCK=50
RUN_SEED=true
PGADMIN_EMAIL=admin@store.com
PGADMIN_PASSWORD=change-this-development-password

# ====== Inventory Service (المتطلب الثاني) ======
# عنوان خدمة المخزون. محلياً: localhost:9090. في Docker: inventory-service:9090
INVENTORY_GRPC_URL=localhost:9090
# مهلة كل نداء gRPC بالـmilliseconds (3 ثوانٍ افتراضياً)
INVENTORY_GRPC_DEADLINE_MS=3000

# ====== قاعدة بيانات خدمة المخزون (لـdocker-compose) ======
INV_DB_USER=postgres
INV_DB_PASSWORD=postgres
INV_DB_NAME=inventory_db

INTERNAL_API_TOKEN=replace-with-a-long-random-secret-at-least-32-chars
INTERNAL_API_TIMEOUT_MS=3000
JWT_USER_CACHE_TTL_SECONDS=60
USERS_API_URL=http://localhost:3000/api/v1
PRODUCTS_API_URL=http://localhost:3000/api/v1
ORDERS_API_URL=http://localhost:3000/api/v1
NOTIFICATIONS_API_URL=http://localhost:3000/api/v1
