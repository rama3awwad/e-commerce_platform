generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/orders-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDERS_DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique @default(autoincrement())
  userId      String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
enum EmailJobStatus {
  QUEUED
  RETRYING
  SENT
  DEAD
}

/// المتطلب الرابع: يُنشأ داخل نفس transaction إنشاء الطلب (Outbox) ويحدّثه الـ Worker.
model EmailJob {
  id          String         @id @default(uuid())
  orderId     String         @unique
  recipient   String
  payload     Json
  status      EmailJobStatus @default(QUEUED)
  attempts    Int            @default(0)
  lastError   String?
  processedBy String?
  publishedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([publishedAt, createdAt])
  @@map("email_jobs")
}
/// المتطلب الرابع: مفاتيح تشغيل بسيطة يغيّرها الأدمن من الواجهة ويقرؤها الـ Worker.
model AppFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_flags")
}
