{
  "name": "ecommerce-backend",
  "version": "0.1.0",
  "description": "E-Commerce platform (clothing store) - Backend API",
  "author": "Internet Tech Club 2026",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/users/schema.prisma && prisma generate --schema prisma/products/schema.prisma && prisma generate --schema prisma/orders/schema.prisma && prisma generate --schema prisma/notifications/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "jest --runInBand",
    "test:e2e": "node scripts/run-e2e.js",
    "test:cov": "jest --coverage --runInBand",
    "postbuild": "npm run copy:proto",
    "copy:proto": "node -e \"require('fs').mkdirSync('dist/inventory/proto',{recursive:true});require('fs').copyFileSync('src/inventory/proto/inventory.proto','dist/inventory/proto/inventory.proto')\"",
    "prisma:deploy": "prisma migrate deploy --schema prisma/users/schema.prisma && prisma migrate deploy --schema prisma/products/schema.prisma && prisma migrate deploy --schema prisma/orders/schema.prisma && prisma migrate deploy --schema prisma/notifications/schema.prisma",
    "check:boundaries": "sh scripts/check-boundaries.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.2.1",
    "axios": "^1.21.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0"
  }
}
